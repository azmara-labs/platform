{
  "name": "@azmr/site",
  "version": "0.0.3",
  "private": true,
  "description": "Azmara Platform documentation site — Next.js, Fumadocs, and Tailwind CSS",
  "scripts": {
    "predev": "pnpm generate:changelog && pnpm generate:registry",
    "dev": "next dev",
    "prebuild": "pnpm generate:changelog && pnpm generate:registry",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "generate:changelog": "tsx scripts/build-changelog.ts",
    "generate:registry": "node ../../packages/ui/scripts/build-registry.mjs --out public/r"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@azmr/core": "workspace:*",
    "@azmr/query": "workspace:*",
    "@azmr/ui": "workspace:*",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-typescript": "^5.3.0",
    "fumadocs-ui": "^16.12.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
