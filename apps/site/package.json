{
  "name": "@azmr/site",
  "version": "0.0.3",
  "private": true,
  "description": "Azmara Platform documentation site — Next.js, Fumadocs, and Tailwind CSS",
  "scripts": {
    "predev": "pnpm generate:changelog && pnpm generate:registry && pnpm generate:tokens && pnpm generate:accessibility",
    "dev": "next dev",
    "prebuild": "pnpm generate:changelog && pnpm generate:registry && pnpm generate:tokens && pnpm generate:accessibility && pnpm generate:llms",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "generate:changelog": "tsx scripts/build-changelog.ts",
    "generate:registry": "node ../../packages/ui/scripts/build-registry.mjs --out public/r",
    "generate:tokens": "tsx scripts/build-tokens.ts",
    "generate:accessibility": "tsx scripts/build-accessibility.ts",
    "generate:llms": "tsx scripts/build-llms.mts",
    "check:pages": "node scripts/axe-pages.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@azmr/core": "workspace:*",
    "@azmr/query": "workspace:*",
    "@azmr/ui": "workspace:*",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-typescript": "^5.3.0",
    "fumadocs-ui": "^16.12.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@azmr/db-core-interface": "workspace:*",
    "@azmr/db-supabase": "workspace:*",
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "acorn": "^8.16.0",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "github-slugger": "^2.0.0",
    "jsdom": "^29.1.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.23",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
