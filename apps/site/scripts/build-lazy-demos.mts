// Writes src/demos/lazy.tsx: one `next/dynamic` import per demo in src/demos/registry.ts, so a docs
// page downloads the JavaScript of the demos it shows and no other. Importing every demo
// statically (the registry) put all of them, about 137 kB gzipped, in the docs route's shared
// chunk, loaded on every docs page including guides with no demos (PAZM-145). Each `import()` is a
// literal at its `dynamic()` call so Next can split and preload it.
//
// Run after adding or removing a demo: tsx scripts/build-lazy-demos.mts (lazy-demos.test.ts fails
// until you do).
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

// The names are read from the registry's source, not by importing it: importing would load every
// demo and the packages they use, which plain Node cannot resolve the way the bundler does.
const registry = readFileSync(
  join(import.meta.dirname, "..", "src", "demos", "registry.ts"),
  "utf8",
);
const body = registry.slice(registry.indexOf("export const demos = {"));
const names = [...body.matchAll(/^\s+"([a-z0-9/-]+)": \w+,$/gm)].map((m) => m[1] as string).sort();
if (names.length === 0) throw new Error("found no demos in src/demos/registry.ts");
const lines = [
  '"use client";',
  "",
  "// Generated by scripts/build-lazy-demos.mts from src/demos/registry.ts. Do not edit by hand.",
  'import dynamic from "next/dynamic";',
  'import type { ComponentType } from "react";',
  'import type { DemoName } from "./registry";',
  "",
  "const lazyDemos: Record<DemoName, ComponentType> = {",
  ...names.map((name) => `  ${JSON.stringify(name)}: dynamic(() => import("./${name}.demo")),`),
  "};",
  "",
  "/** Renders one demo, loading only that demo's JavaScript. */",
  "export function LazyDemo({ name }: { name: DemoName }) {",
  "  const Demo = lazyDemos[name];",
  "  return <Demo />;",
  "}",
  "",
  "export const lazyDemoNames = Object.keys(lazyDemos);",
  "",
];
writeFileSync(join(import.meta.dirname, "..", "src", "demos", "lazy.tsx"), lines.join("\n"));
console.log(`[build-lazy-demos] wrote ${names.length} lazy demos to src/demos/lazy.tsx`);
