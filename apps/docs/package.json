{
  "name": "@azmr/docs",
  "version": "0.0.3",
  "private": true,
  "description": "Azmara Platform documentation site — Next.js, Fumadocs, and Tailwind CSS",
  "scripts": {
    "predev": "pnpm generate:changelog",
    "dev": "next dev",
    "prebuild": "pnpm generate:changelog",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "generate:changelog": "tsx scripts/build-changelog.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.15.0",
  "dependencies": {
    "@azmr/core": "workspace:*",
    "@azmr/query": "workspace:*",
    "@azmr/ui": "workspace:*",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-typescript": "^5.3.0",
    "fumadocs-ui": "^16.12.1",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
