{
  "name": "@azmr/db-supabase",
  "version": "0.2.3",
  "description": "Async DbAdapter implementation backed by Supabase's PostgREST query builder",
  "type": "module",
  "license": "MIT",
  "author": "Alshafaraz Gazi <alshafaraz.gazi@gmail.com>",
  "homepage": "https://platform.azmara.io/docs/packages/db-supabase",
  "bugs": {
    "url": "https://github.com/azmara-labs/platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azmara-labs/platform.git",
    "directory": "packages/db-supabase"
  },
  "keywords": [
    "supabase",
    "postgrest",
    "database",
    "adapter",
    "azmara"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azmr/db-core-interface": "workspace:^",
    "@azmr/security": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.103.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
