    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/copy-css.mjs && node scripts/build-classes.mjs && node scripts/verify-dist.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/copy-css.mjs\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "size": "size-limit && node scripts/check-css-size.mjs && node scripts/check-class-lists.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "verify:guides": "node scripts/verify-guides.mjs",
    "verify:registry": "node scripts/verify-registry.mjs"
  },
