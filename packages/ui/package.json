{
  "name": "@azmr/ui",
  "version": "0.1.0",
  "description": "React UI components wired to reactive Signals — Grid, useSignal",
  "type": "module",
  "license": "MIT",
  "author": "Alshafaraz Gazi <alshafaraz.gazi@gmail.com>",
  "homepage": "https://docs.azmara.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azmara-labs/platform.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "components",
    "grid",
    "reactive",
    "signals",
    "data-table",
    "azmara"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./icons/lucide": {
      "types": "./dist/icons/lucide.d.ts",
      "import": "./dist/icons/lucide.js"
    },
    "./icons/mui-map": {
      "types": "./dist/icons/mui-map.d.ts",
      "import": "./dist/icons/mui-map.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/copy-css.mjs && node scripts/verify-dist.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/copy-css.mjs\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "size": "size-limit && node scripts/check-css-size.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@azmr/core": ">=0.0.2 <1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@azmr/core": "workspace:*",
    "@mui/icons-material": "^9.5.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.1.10",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "esbuild": "^0.27.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.90.0",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
