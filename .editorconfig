# Editor defaults for every file in the repo. Line endings are LF everywhere (see .gitattributes);
# Biome enforces the same for the files it formats.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
